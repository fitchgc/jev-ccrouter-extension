{
  "id": "jev-ccrouter-extension",
  "name": "JEV Smart Router",
  "version": "0.1.0",
  "description": "Routes CCR Codex requests to one of four configured Allowed models using JEV.",
  "module": "index.cjs",
  "surfaces": ["apps", "gateway"],
  "permissions": [
    "trusted-code",
    "apps",
    "gateway-routes",
    "http-backends",
    "proxy-routes"
  ],
  "apps": [
    {
      "id": "jev-smart-router",
      "name": "JEV Smart Router",
      "url": "http://127.0.0.1:3456/extensions/jev-smart-router"
    }
  ]
}
